# Public IP address of your VPS, without https:// or port.
SERVER_ADDRESS=203.0.113.10
# External HTTPS port. Port 443 and port 80 are not required.
HTTPS_PORT=8443
LISTEN_ADDRESS=0.0.0.0
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SETUP_SECRET=replace-with-a-random-secret-at-least-32-characters
